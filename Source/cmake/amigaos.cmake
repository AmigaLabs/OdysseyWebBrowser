SET(CAIRO_INCLUDE_DIRS /usr/ppc-amigaos/SDK/local/clib4/include/cairo)
SET(WOFF2_LIBRARIES "/usr/ppc-amigaos/SDK/local/clib4/lib/libwoff2dec.a;/usr/ppc-amigaos/SDK/local/clib4/lib/libwoff2enc.a;/usr/ppc-amigaos/SDK/local/clib4/lib/libwoff2common.a")
