SET(CMAKE_SYSTEM_NAME AmigaOS4)
SET(AmigaOS4 1)
SET(CMAKE_SYSTEM_VERSION 1)
SET(CMAKE_SYSTEM_PROCESSOR ppc)
SET(CMAKE_C_COMPILER /usr/bin/ppc-amigaos-gcc)
SET(CMAKE_CXX_COMPILER /usr/bin/ppc-amigaos-g++)
SET(CXX_STANDARD_REQUIRED ON)
SET(CXX_STANDARD 14)
#SET(CMAKE_CXX_FLAGS "-mcrt=clib4 -mstrict-align -std=c++14 -O3 -DLOG_DISABLED=0 -DCAIRO_HAS_FC_FONT -D_GNU_SOURCE -D__USE_INLINE__ -g0 -gstabs1 -feliminate-unused-debug-symbols -mlongcall -mno-sched-prolog -Wfatal-errors -Wwrite-strings -Wno-ignored-attributes -Wno-unused-but-set-parameter -Wno-unused-parameter -Wno-cast-align -I/usr/ppc-amigaos/SDK/MUI_5.0/C/include/ -I/usr/ppc-amigaos/SDK/local/clib4/include")
# TEMP (build speed): -O1 and no -gdwarf-2 for faster compiles. Revert to: -O3 ... -fpermissive -O3 -DNDEBUG ... -gdwarf-2 ...
SET(CMAKE_CXX_FLAGS "-mcrt=clib4 -mstrict-align -std=c++14 -fpermissive -O1 -DNDEBUG -DUSE_CAIRO -DCAIRO_HAS_FC_FONT -D_GNU_SOURCE -D__USE_INLINE__ -feliminate-unused-debug-symbols -mlongcall -mno-sched-prolog -Wwrite-strings -Wno-ignored-attributes -Wno-unused-but-set-parameter -Wno-unused-parameter -Wno-cast-align -I/usr/ppc-amigaos/SDK/MUI_5.0/C/include/ -I/usr/ppc-amigaos/SDK/local/clib4/include")
SET(CMAKE_CXX_FLAGS_RELEASE "")
SET(CMAKE_CXX_FLAGS_DEBUG "-mlongcall -mno-sched-prolog -Wno-ignored-attributes -Wno-unused-but-set-parameter")
SET(CMAKE_CXX_FLAGS_RELEASE_INIT "")
# TEMP (build speed): -O1 instead of -O3. Revert to -O3 (see CMAKE_CXX_FLAGS above)
SET(CMAKE_C_FLAGS "-mcrt=clib4 -mstrict-align -O1 -DCAIRO_HAS_FC_FONT -DUSE_CAIRO -D_GNU_SOURCE -D__USE_INLINE__ -mlongcall -mno-sched-prolog -Wno-ignored-attributes -Wno-cast-align -I/usr/ppc-amigaos/SDK/MUI_5.0/C/include/ -I/usr/ppc-amigaos/SDK/local/clib4/include")
SET(CMAKE_C_FLAGS_DEBUG "-mlongcall -mno-sched-prolog -Wno-ignored-attributes -Wwrite-strings ")
SET(CMAKE_MODULE_LINKER_FLAGS "-lpthread -athread=native")
SET(CMAKE_LD_FLAGS "-mcrt=clib4 -athread=native -lpthread")
SET(CMAKE_EXE_LINKER_FLAGS "-mcrt=clib4 -lpthread -Wl,--no-undefined -athread=native")
SET(CMAKE_C_STANDARD_LIBRARIES "-lpthread")  # after static libs, else WTF pthread_* stay undefined
SET(CMAKE_CXX_STANDARD_LIBRARIES "-lpthread")
SET(CMAKE_FIND_LIBRARY_SUFFIXES .a)
SET(ODISSEY_PLATFORM "AmigaOS4")
SET(AROS_SDK_DIR /usr/ppc-amigaos/SDK/local/clib4)
SET(CMAKE_FIND_ROOT_PATH /usr/ppc-amigaos/SDK/local/clib4)
SET(CMAKE_LIBRARY_PATH /usr/ppc-amigaos/SDK/local/clib4/lib)
SET(CMAKE_INCLUDE_PATH /usr/ppc-amigaos/SDK/local/clib4/include)
SET(SQLite3_LIBRARY /usr/ppc-amigaos/SDK/local/clib4/lib/sqlite/instdir/include)
SET(SQLite3_INCLUDE_DIR /usr/ppc-amigaos/SDK/local/common/include)
SET(NGHTTP2_INCLUDE_DIRS /usr/ppc-amigaos/SDK/local/common/include)
SET(HYPHEN_INCLUDE_DIR /usr/ppc-amigaos/SDK/local/common/include/hyphen)
SET(HarfBuzz_INCLUDE_DIRS /usr/ppc-amigaos/SDK/local/clib4/include/harfbuzz)
SET(CURL_INCLUDE_DIR /usr/ppc-amigaos/SDK/local/common/include/curl)
SET(OpenJPEG_INCLUDE_DIR /usr/ppc-amigaos/SDK/local/clib4/include/openjpeg-2.5)
SET(WebP_DEMUX_LIBRARY /usr/ppc-amigaos/SDK/local/clib4/lib/libwebpdemux.a)
SET(HarfBuzz_ICU_LIBRARY /usr/ppc-amigaos/SDK/local/clib4/lib/libharfbuzz-icu.a)
SET(Fontconfig_INCLUDE_DIR /usr/ppc-amigaos/SDK/local/common/include)
SET(ICU_I18N_LIBRARY /usr/ppc-amigaos/SDK/local/clib4/lib/libicui18n.a)
SET(ICU_DATA_LIBRARY /usr/ppc-amigaos/SDK/local/clib4/lib/libicudata.a)
